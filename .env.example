# Flask
SECRET_KEY=replace-with-a-long-random-string
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL (consumed by docker-compose and the db healthcheck)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# docker-compose injects these automatically; uncomment to override
# DATABASE_URL=postgresql://nexus:nexus@db:5432/nexus
# REDIS_URL=redis://redis:6379/0

# Keep true to run the demo without access to network hardware
SIMULATE_SSH=true
